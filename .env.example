# The default local profile needs no credentials. Copy only values you want to override.
WORKBENCH_DOCKER_CONTEXT=colima-research
WORKBENCH_IMAGE=research-workbench-r:reference
WORKBENCH_ORIGINS=["http://127.0.0.1:8317","http://localhost:8317","http://127.0.0.1:3000","http://localhost:3000"]

# Absolute path, shared by the API and worker. Defaults to this checkout's .runtime.
# WORKBENCH_DATA_DIR=/absolute/path/to/workbench-data
# WORKBENCH_DATABASE_URL=postgresql+psycopg://workbench:password@127.0.0.1:5432/workbench

# Team mode requires all three. Configure the exact public origin above.
# WORKBENCH_OIDC_ISSUER=https://identity.example/tenant
# WORKBENCH_OIDC_AUDIENCE=research-workbench
# WORKBENCH_OIDC_JWKS_URL=https://identity.example/tenant/jwks

# Optional broker. Prices must be configured from your provider's current rate card.
# WORKBENCH_MODEL_URL=https://provider.example/v1/chat/completions
# WORKBENCH_MODEL_KEY=
# WORKBENCH_MODEL_NAME=
# WORKBENCH_MODEL_INPUT_PER_MILLION=0
# WORKBENCH_MODEL_OUTPUT_PER_MILLION=0
WORKBENCH_MODEL_BUDGET_USD=2
